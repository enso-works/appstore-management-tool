{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "The screen's name: lowercase letters, digits and dashes. It names its copy, captures and files."
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Its position on the default page, from 1."
          },
          "enabled": {
            "default": true,
            "type": "boolean",
            "description": "On the default page; false keeps it for other pages, or for the header and event pictures."
          },
          "template": {
            "type": "string",
            "minLength": 1,
            "description": "The template id: hero-top, split-caption, full-bleed-card or feature-graphic."
          },
          "source": {
            "default": {},
            "type": "object",
            "properties": {
              "filePattern": {
                "default": "{order}-{id}.png",
                "type": "string",
                "minLength": 1,
                "description": "Interpolates {order} {id} {locale} {device} {target}. Relative to raw/<device>/<locale>/."
              },
              "localized": {
                "default": true,
                "type": "boolean",
                "description": "false: use the default-locale capture for every locale."
              },
              "deepLink": {
                "type": "string",
                "minLength": 1,
                "description": "Deep link the capture helper opens before screenshotting (capture --all), e.g. \"braele://session/478\"."
              }
            },
            "additionalProperties": false,
            "description": "Where the screen's capture is."
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Only for targets listed here; default: all configured targets."
          },
          "panorama": {
            "type": "object",
            "properties": {
              "slices": {
                "type": "integer",
                "minimum": 2,
                "maximum": 3,
                "description": "How many screenshots wide: 2 or 3."
              }
            },
            "required": [
              "slices"
            ],
            "additionalProperties": false,
            "description": "Panorama: render one artwork `slices` screenshots wide and cut it into\nconsecutive files (order, order+1, ...). The following order numbers are\nreserved for the slices."
          },
          "overrides": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {},
            "description": "The layout and background the inspector sets; see screens[].overrides below."
          },
          "layers": {
            "default": [],
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "image"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]*$"
                    },
                    "asset": {
                      "type": "string",
                      "minLength": 1
                    },
                    "x": {
                      "type": "number",
                      "minimum": -0.5,
                      "maximum": 3.5
                    },
                    "y": {
                      "type": "number",
                      "minimum": -0.5,
                      "maximum": 3.5
                    },
                    "width": {
                      "default": 0.3,
                      "type": "number",
                      "minimum": 0.02,
                      "maximum": 2
                    },
                    "rotate": {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    },
                    "opacity": {
                      "type": "number",
                      "minimum": 0.05,
                      "maximum": 1
                    },
                    "targets": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "iphone-6.9-1320x2868",
                          "iphone-6.1-1206x2622",
                          "iphone-duo-1398x2034",
                          "iphone-duo-2007x2853",
                          "iphone-duo-2034x1398",
                          "iphone-duo-2853x2007",
                          "ipad-13-2064x2752",
                          "iphone-6.9-2868x1320",
                          "iphone-6.1-2622x1206",
                          "ipad-13-2752x2064",
                          "play-phone-1080x1920",
                          "play-feature-1024x500",
                          "appreview-6.9-886x1920",
                          "event-card-1920x1080",
                          "event-detail-1080x1920",
                          "header-3840x1646",
                          "search-3840x2560",
                          "universal-5244x2950"
                        ]
                      }
                    }
                  },
                  "required": [
                    "type",
                    "id",
                    "asset",
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "text"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]*$"
                    },
                    "x": {
                      "type": "number",
                      "minimum": -0.5,
                      "maximum": 3.5
                    },
                    "y": {
                      "type": "number",
                      "minimum": -0.5,
                      "maximum": 3.5
                    },
                    "width": {
                      "default": 0.5,
                      "type": "number",
                      "minimum": 0.05,
                      "maximum": 2
                    },
                    "size": {
                      "default": 0.045,
                      "type": "number",
                      "minimum": 0.01,
                      "maximum": 0.3
                    },
                    "weight": {
                      "default": 600,
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 900
                    },
                    "color": {
                      "type": "string",
                      "minLength": 1
                    },
                    "align": {
                      "default": "center",
                      "type": "string",
                      "enum": [
                        "start",
                        "center",
                        "end"
                      ]
                    },
                    "font": {
                      "default": "body",
                      "type": "string",
                      "enum": [
                        "body",
                        "headline"
                      ]
                    },
                    "rotate": {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    },
                    "opacity": {
                      "type": "number",
                      "minimum": 0.05,
                      "maximum": 1
                    },
                    "targets": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "iphone-6.9-1320x2868",
                          "iphone-6.1-1206x2622",
                          "iphone-duo-1398x2034",
                          "iphone-duo-2007x2853",
                          "iphone-duo-2034x1398",
                          "iphone-duo-2853x2007",
                          "ipad-13-2064x2752",
                          "iphone-6.9-2868x1320",
                          "iphone-6.1-2622x1206",
                          "ipad-13-2752x2064",
                          "play-phone-1080x1920",
                          "play-feature-1024x500",
                          "appreview-6.9-886x1920",
                          "event-card-1920x1080",
                          "event-detail-1080x1920",
                          "header-3840x1646",
                          "search-3840x2560",
                          "universal-5244x2950"
                        ]
                      }
                    }
                  },
                  "required": [
                    "type",
                    "id",
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "description": "Extra image/text elements composited over the template. Text layers read content field <layer id>."
          },
          "appearance": {
            "type": "string",
            "enum": [
              "light",
              "dark"
            ],
            "description": "What the capture shows. Apple suggests one Dark Mode screenshot when the app supports it; readiness looks for it."
          }
        },
        "required": [
          "id",
          "order",
          "template"
        ],
        "additionalProperties": false
      }
    },
    "sets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "The page's name in the tool: lowercase letters, digits and dashes."
          },
          "kind": {
            "type": "string",
            "enum": [
              "custom",
              "ppo"
            ],
            "description": "\"custom\" for a custom product page, \"ppo\" for an optimization test treatment."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The page's or treatment's name in App Store Connect, for your reference."
          },
          "screens": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "description": "Screen ids, in the order the set shows them."
          },
          "deepLink": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9+.-]*:\\/\\/\\S+$",
            "description": "Custom product pages: where the app opens when installed from this page (a URL or the app's own scheme)."
          },
          "appIconName": {
            "type": "string",
            "minLength": 1,
            "description": "Optimization treatments: an alternate app icon in the shipped binary (its name in the asset catalog)."
          },
          "experiment": {
            "type": "string",
            "minLength": 1,
            "description": "Optimization treatments: the experiment (test) it belongs to; treatments with one name share it."
          },
          "ascId": {
            "type": "string",
            "description": "App Store Connect's id for this page or treatment, written when the tool first uploads it.\nAn editor sends \"\" to unlink it (the page was deleted there, or the test ended)."
          }
        },
        "required": [
          "id",
          "kind",
          "screens"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "screens"
  ],
  "additionalProperties": false
}

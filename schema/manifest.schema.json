{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "enabled": {
            "default": true,
            "type": "boolean"
          },
          "template": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "default": {},
            "type": "object",
            "properties": {
              "filePattern": {
                "default": "{order}-{id}.png",
                "type": "string",
                "minLength": 1
              },
              "localized": {
                "default": true,
                "type": "boolean"
              },
              "deepLink": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "panorama": {
            "type": "object",
            "properties": {
              "slices": {
                "type": "integer",
                "minimum": 2,
                "maximum": 3
              }
            },
            "required": [
              "slices"
            ],
            "additionalProperties": false
          },
          "overrides": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "id",
          "order",
          "template"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "screens"
  ],
  "additionalProperties": false
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "enabled": {
            "default": true,
            "type": "boolean"
          },
          "template": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "default": {},
            "type": "object",
            "properties": {
              "filePattern": {
                "default": "{order}-{id}.png",
                "type": "string",
                "minLength": 1
              },
              "localized": {
                "default": true,
                "type": "boolean"
              },
              "deepLink": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "panorama": {
            "type": "object",
            "properties": {
              "slices": {
                "type": "integer",
                "minimum": 2,
                "maximum": 3
              }
            },
            "required": [
              "slices"
            ],
            "additionalProperties": false
          },
          "overrides": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "layers": {
            "default": [],
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "image"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]*$"
                    },
                    "asset": {
                      "type": "string",
                      "minLength": 1
                    },
                    "x": {
                      "type": "number",
                      "minimum": -0.5,
                      "maximum": 3.5
                    },
                    "y": {
                      "type": "number",
                      "minimum": -0.5,
                      "maximum": 3.5
                    },
                    "width": {
                      "default": 0.3,
                      "type": "number",
                      "minimum": 0.02,
                      "maximum": 2
                    },
                    "rotate": {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    },
                    "opacity": {
                      "type": "number",
                      "minimum": 0.05,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "type",
                    "id",
                    "asset",
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "text"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]*$"
                    },
                    "x": {
                      "type": "number",
                      "minimum": -0.5,
                      "maximum": 3.5
                    },
                    "y": {
                      "type": "number",
                      "minimum": -0.5,
                      "maximum": 3.5
                    },
                    "width": {
                      "default": 0.5,
                      "type": "number",
                      "minimum": 0.05,
                      "maximum": 2
                    },
                    "size": {
                      "default": 0.045,
                      "type": "number",
                      "minimum": 0.01,
                      "maximum": 0.3
                    },
                    "weight": {
                      "default": 600,
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 900
                    },
                    "color": {
                      "type": "string",
                      "minLength": 1
                    },
                    "align": {
                      "default": "center",
                      "type": "string",
                      "enum": [
                        "start",
                        "center",
                        "end"
                      ]
                    },
                    "font": {
                      "default": "body",
                      "type": "string",
                      "enum": [
                        "body",
                        "headline"
                      ]
                    },
                    "rotate": {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    },
                    "opacity": {
                      "type": "number",
                      "minimum": 0.05,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "type",
                    "id",
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "order",
          "template"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "screens"
  ],
  "additionalProperties": false
}

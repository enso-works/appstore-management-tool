{
  "name": "store-shots",
  "version": "1.1.0",
  "//": "Remove `private` to publish to npm. Kept on deliberately while the tool is still being built - the name is unclaimed and publishing early would spend it on a half-ready release.",
  "private": true,
  "description": "Open-source App Store screenshot builder for iOS and Google Play. Generate exact-size, localized store screenshots from raw captures, and catch overflowing headlines, missing glyphs and stale screens before you upload.",
  "keywords": [
    "app-store-screenshot-builder",
    "app-store-screenshot-generator",
    "app-store-screenshots",
    "app-store-screenshot-sizes",
    "google-play-screenshots",
    "screenshot-generator",
    "app-store",
    "google-play",
    "aso",
    "localization",
    "fastlane",
    "expo",
    "react-native",
    "ios",
    "android"
  ],
  "homepage": "https://bavrk.com/articles/app-store-screenshot-generator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enso-works/appstore-management-tool.git"
  },
  "bugs": {
    "url": "https://github.com/enso-works/appstore-management-tool/issues"
  },
  "author": "Ensar Bavrk (https://bavrk.com)",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cli": "tsx cli/index.ts",
    "schemas": "tsx scripts/gen-schemas.ts",
    "fixtures": "tsx scripts/make-fixture.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@uiw/react-color": "^2.10.3",
    "commander": "^15.0.0",
    "next": "16.3.1",
    "opentype.js": "^2.0.0",
    "playwright": "^1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "bin": {
    "store-shots": "./bin/store-shots.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}

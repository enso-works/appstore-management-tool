{
  "name": "store-shots-site",
  "private": true,
  "//": "The docs site. Its own install (npm ci here), so the engine's dependencies stay its own. The reference pages are generated from the engine's code at build (npm run content), so the engine's install is needed too.",
  "scripts": {
    "dev": "npm run content && next dev -p 3120",
    "build": "npm run content && next build",
    "start": "serve out -l 3120",
    "typecheck": "next typegen && tsc --noEmit",
    "content": "node scripts/images.mjs && npm --prefix .. run --silent docs:reference"
  },
  "dependencies": {
    "fumadocs-core": "16.17.1",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.1",
    "lucide-react": "^1.50.0",
    "next": "16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
